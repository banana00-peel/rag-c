APP_NAME=Roborock RAG
APP_ENV=development
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可接入任意兼容 OpenAI /v1/embeddings 协议的 Embedding 服务。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

DATA_DIR=data
UPLOAD_DIR=data/documents
CHROMA_DIR=data/chroma
BM25_SNAPSHOT_PATH=data/bm25/snapshot.json
DATABASE_URL=sqlite:///./data/app.db

MAX_UPLOAD_MB=50
CHUNK_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DENSE_TOP_K=8
BM25_TOP_K=8
CONTEXT_TOP_K=5
RRF_K=60
MAX_DENSE_DISTANCE=0.75
MIN_BM25_SCORE=0.0
MAX_CONTEXT_CHUNKS_PER_DOCUMENT=3
CONTEXT_MERGE_MAX_CHARS=1600

# 短期会话记忆：只读取最近若干完整轮次，并限制总字符数。
CONVERSATION_HISTORY_TURNS=6
CONVERSATION_HISTORY_MAX_CHARS=6000
CONVERSATION_TTL_MINUTES=60


